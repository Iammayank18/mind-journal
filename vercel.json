{
  "redirects": [
    { "source": "/Daily_Planner_Mayank.html", "destination": "/planner.html", "permanent": true },
    { "source": "/mind-journal.html", "destination": "/journal.html", "permanent": true },
    { "source": "/mind-journal-landing.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
